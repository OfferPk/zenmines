{
  "name": "zenmines",
  "version": "1.1.0",
  "description": "ZenMines: sleek, modern offline minesweeper (vanilla JS + Capacitor Android)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node test/logic.test.js",
    "generate-icons": "node scripts/generate-icons.js",
    "cap:sync": "npm run build && npx cap sync android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "smoke": "node test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OfferPk/zenmines.git"
  },
  "keywords": [
    "minesweeper",
    "offline-game",
    "casual-game",
    "capacitor",
    "pwa",
    "puzzle"
  ],
  "author": "OfferPk",
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "playwright-core": "^1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
